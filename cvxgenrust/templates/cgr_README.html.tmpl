<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>CvxGenRust - __MODULE_NAME_TEXT__</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      --ink: #1f2933;
      --soft-ink: #52606d;
      --rule: #d7dee8;
      --paper: #ffffff;
      --wash: #f5f7fb;
      --panel: #eef4f8;
      --rust: #8a4b2a;
      --teal: #0f766e;
      --teal-soft: #d9f0ec;
      --code: #f8fafc;
      --code-rule: #d8e0ea;
      --radius: 6px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 15px;
      line-height: 1.6;
    }
    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }
    code, pre {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.92em;
    }
    code {
      padding: 0.1rem 0.35rem;
      border: 1px solid var(--code-rule);
      border-radius: 4px;
      background: var(--code);
    }
    pre {
      margin: 0.75rem 0 1.1rem;
      padding: 1rem;
      overflow-x: auto;
      border: 1px solid var(--code-rule);
      border-radius: var(--radius);
      background: var(--code);
    }
    pre code { padding: 0; border: 0; background: transparent; }

    .page-head {
      border-bottom: 1px solid var(--rule);
      background:
        linear-gradient(90deg, rgba(15,118,110,.12), transparent 55%),
        var(--wash);
    }
    .head-inner, main {
      width: min(1120px, calc(100vw - 40px));
      margin: 0 auto;
    }
    .head-inner { padding: 28px 0 22px; }
    .brand-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 18px;
    }
    .brand {
      margin: 0;
      font-size: 1.85rem;
      line-height: 1.15;
      letter-spacing: 0;
    }
    .module-chip {
      display: inline-block;
      margin-left: 0.45rem;
      padding: 0.15rem 0.5rem;
      color: #083b36;
      background: var(--teal-soft);
      border: 1px solid #8ed4cb;
      border-radius: 999px;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.95rem;
      vertical-align: middle;
    }
    .generated-meta {
      color: var(--soft-ink);
      font-size: 0.82rem;
      text-align: right;
      white-space: nowrap;
    }
    .summary-line {
      max-width: 760px;
      margin: 0 0 18px;
      color: var(--soft-ink);
    }
    .quick-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .quick-nav a {
      padding: 0.38rem 0.7rem;
      color: var(--ink);
      border: 1px solid var(--rule);
      border-radius: 999px;
      background: #fff;
      font-size: 0.88rem;
    }

    main { padding: 32px 0 56px; }
    section { margin-bottom: 38px; }
    h2 {
      margin: 0 0 14px;
      font-size: 1.25rem;
      line-height: 1.25;
      color: #17413d;
    }
    h3 {
      margin: 0 0 8px;
      font-size: 1rem;
      color: var(--rust);
    }
    p { margin: 0 0 0.9rem; }

    .problem-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    .info-box {
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: #fff;
      overflow: hidden;
    }
    .info-box h3 {
      padding: 0.75rem 0.9rem;
      margin: 0;
      color: #17413d;
      background: var(--panel);
      border-bottom: 1px solid var(--rule);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    th, td {
      padding: 0.58rem 0.72rem;
      text-align: left;
      border-bottom: 1px solid var(--rule);
      vertical-align: top;
    }
    th { color: var(--soft-ink); font-weight: 650; background: #fbfcfe; }
    tr:last-child td { border-bottom: 0; }
    td code { border: 0; background: transparent; padding: 0; }

    .file-browser {
      display: grid;
      grid-template-columns: minmax(260px, 0.9fr) minmax(320px, 1.1fr);
      gap: 18px;
      align-items: start;
    }
    .file-tree {
      margin: 0;
      padding: 1rem 1.1rem;
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: #fff;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.9rem;
      line-height: 1.8;
      list-style: none;
    }
    .file-tree ul {
      margin: 0;
      padding-left: 1.35rem;
      list-style: none;
      border-left: 1px solid var(--rule);
    }
    .file-tree li { position: relative; }
    .file-tree li::before {
      content: "";
      position: absolute;
      left: -1.35rem;
      top: 0.9rem;
      width: 0.85rem;
      border-top: 1px solid var(--rule);
    }
    .file-tree > li::before { display: none; }
    .dir { color: var(--rust); font-weight: 650; }
    .file { color: #17413d; }
    .file-notes {
      display: grid;
      gap: 10px;
    }
    .file-note {
      padding: 0.8rem 0.9rem;
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: #fff;
    }
    .file-note strong {
      display: block;
      margin-bottom: 0.25rem;
      color: #17413d;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.88rem;
    }
    .file-note p { margin: 0; color: var(--soft-ink); }

    .usage-card, .api-card {
      padding: 1rem;
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: #fff;
      margin-bottom: 14px;
    }
    @media (max-width: 760px) {
      .head-inner, main { width: min(100vw - 28px, 1120px); }
      .brand-row, .problem-grid, .file-browser { display: block; }
      .generated-meta { margin-top: 10px; text-align: left; white-space: normal; }
      .info-box, .file-tree, .file-note, .api-card { margin-bottom: 12px; }
      .brand { font-size: 1.45rem; }
      .module-chip { display: table; margin: 0.4rem 0 0; }
    }
  </style>
</head>
