/// Generated solver handle for this CVXPY problem.
///
/// A `CGRProblem` owns the current flattened parameter values. Parameters start
/// at zero. Configure Clarabel by passing native
/// [`ClarabelSettings`] values to
/// [`CGRProblem::solve_with_settings`].
pub struct CGRProblem {
    parameter_values: Vec<f64>,
}

impl Default for CGRProblem {
    fn default() -> Self {
        Self::new()
    }
}

impl CGRProblem {
    /// Creates a new problem with zero-filled parameters.
    pub fn new() -> Self {
        Self {
            parameter_values: vec![0.0; __PARAMETER_VEC_LEN_MINUS_ONE__usize],
        }
    }

    /// Returns static metadata for generated parameter blocks.
    pub fn parameter_info(&self) -> &'static [ParameterInfo] {
        &PARAMETERS
    }

    /// Returns static metadata for primal variable blocks in [`SolveResult::x`].
    pub fn variable_info(&self) -> &'static [VariableInfo] {
        &VARIABLES
    }

    /// Returns static metadata for canonical dual blocks in [`SolveResult::z`].
    pub fn dual_variable_info(&self) -> &'static [DualVariableInfo] {
        &DUAL_VARIABLES
    }

    /// Returns the flattened parameter vector used by the canonicalization maps.
    ///
    /// The vector contains all parameter entries in generated metadata order,
    /// followed by a trailing `1.0` constant slot used by affine maps.
    pub fn parameter_vector(&self) -> Vec<f64> {
        let mut out = self.parameter_values.clone();
        out.push(1.0);
        out
    }

    /// Replaces one named parameter block.
    ///
    /// `value` must contain exactly the flattened size reported by
    /// [`CGRProblem::parameter_info`]. Returns [`RuntimeError::UnknownParameter`]
    /// for an unknown name and [`RuntimeError::DimensionMismatch`] for the wrong
    /// length.
    pub fn set_parameter(&mut self, name: &str, value: &[f64]) -> Result<(), RuntimeError> {
        let parameter = PARAMETERS
            .iter()
            .find(|parameter| parameter.name == name)
            .ok_or_else(|| RuntimeError::UnknownParameter(name.to_owned()))?;

        if value.len() != parameter.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: parameter.size,
                actual: value.len(),
                name: "parameter",
            });
        }

        let start = parameter.offset;
        let end = start + parameter.size;
        self.parameter_values[start..end].copy_from_slice(value);
        Ok(())
    }

    /// Updates one scalar entry of a named parameter block.
    ///
    /// `index` is zero-based within the parameter's flattened block. Returns
    /// [`RuntimeError::UnknownParameter`] for an unknown name and
    /// [`RuntimeError::DimensionMismatch`] when `index` is out of bounds.
    pub fn update_parameter_entry(
        &mut self,
        name: &str,
        index: usize,
        value: f64,
    ) -> Result<(), RuntimeError> {
        let parameter = PARAMETERS
            .iter()
            .find(|parameter| parameter.name == name)
            .ok_or_else(|| RuntimeError::UnknownParameter(name.to_owned()))?;

        if index >= parameter.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: parameter.size,
                actual: index + 1,
                name: "parameter_entry",
            });
        }

        self.parameter_values[parameter.offset + index] = value;
        Ok(())
    }

