__SOLVE_METHOD__
    /// Extracts one named primal variable block from a solution vector.
    ///
    /// Pass [`SolveResult::x`] from this generated solver. Returns
    /// [`RuntimeError::UnknownVariable`] for an unknown name and
    /// [`RuntimeError::DimensionMismatch`] if the solution vector is too short.
    pub fn extract_variable(&self, name: &str, solution: &[f64]) -> Result<Vec<f64>, RuntimeError> {
        let variable = VARIABLES
            .iter()
            .find(|variable| variable.name == name)
            .ok_or_else(|| RuntimeError::UnknownVariable(name.to_owned()))?;

        if solution.len() < variable.offset + variable.canonical_size {
            return Err(RuntimeError::DimensionMismatch {
                expected: variable.offset + variable.canonical_size,
                actual: solution.len(),
                name: "solution",
            });
        }

        let canonical = &solution[variable.offset..variable.offset + variable.canonical_size];
        match variable.unpack {
            "identity" => {
                if variable.canonical_size != variable.size {
                    return Err(RuntimeError::MalformedMap(
                        "identity variable metadata has mismatched canonical and user sizes",
                    ));
                }
                Ok(canonical.to_vec())
            }
            "symmetric" => {
                if variable.shape.len() != 2 || variable.shape[0] != variable.shape[1] {
                    return Err(RuntimeError::MalformedMap(
                        "symmetric variable metadata must have a square matrix shape",
                    ));
                }
                let n = variable.shape[0];
                let expected_canonical = n * (n + 1) / 2;
                if variable.canonical_size != expected_canonical || variable.size != n * n {
                    return Err(RuntimeError::MalformedMap(
                        "symmetric variable metadata has inconsistent packed size",
                    ));
                }

                let mut out = vec![0.0; variable.size];
                let mut slot = 0usize;
                for col in 0..n {
                    for row in col..n {
                        let value = canonical[slot];
                        out[row + col * n] = value;
                        out[col + row * n] = value;
                        slot += 1;
                    }
                }
                Ok(out)
            }
            _ => Err(RuntimeError::MalformedMap(
                "unknown variable unpacking rule",
            )),
        }
    }

    /// Extracts one named canonical dual block from a dual solution vector.
    ///
    /// Pass [`SolveResult::z`] from this generated solver. These blocks are
    /// canonical dual slices and may not map one-to-one to original CVXPY
    /// constraints when CVXPY splits constraints during canonicalization.
    pub fn extract_dual_variable(
        &self,
        name: &str,
        dual_solution: &[f64],
    ) -> Result<Vec<f64>, RuntimeError> {
        let dual_variable = DUAL_VARIABLES
            .iter()
            .find(|dual_variable| dual_variable.name == name)
            .ok_or_else(|| RuntimeError::UnknownDualVariable(name.to_owned()))?;

        if dual_solution.len() < dual_variable.offset + dual_variable.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: dual_variable.offset + dual_variable.size,
                actual: dual_solution.len(),
                name: "dual_solution",
            });
        }

        Ok(dual_solution[dual_variable.offset..dual_variable.offset + dual_variable.size].to_vec())
    }

