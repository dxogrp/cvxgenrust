__RUNTIME_RS__

static PARAMETERS: [ParameterInfo; __PARAMETER_COUNT__] = [
    __PARAMETERS__
];

static VARIABLES: [VariableInfo; __VARIABLE_COUNT__] = [
    __VARIABLES__
];

static DUAL_VARIABLES: [DualVariableInfo; __DUAL_VARIABLE_COUNT__] = [
    __DUAL_VARIABLES__
];

pub struct CGRProblem {
    parameter_values: Vec<f64>,
    solver_settings: clarabel::solver::DefaultSettings<f64>,
}

impl Default for CGRProblem {
    fn default() -> Self {
        Self::new()
    }
}

impl CGRProblem {
    pub fn new() -> Self {
        let mut solver_settings = clarabel::solver::DefaultSettings::<f64>::default();
        solver_settings.verbose = false;
        Self {
            parameter_values: vec![0.0; __PARAMETER_VEC_LEN_MINUS_ONE__usize],
            solver_settings,
        }
    }

    pub fn parameter_info(&self) -> &'static [ParameterInfo] {
        &PARAMETERS
    }

    pub fn variable_info(&self) -> &'static [VariableInfo] {
        &VARIABLES
    }

    pub fn dual_variable_info(&self) -> &'static [DualVariableInfo] {
        &DUAL_VARIABLES
    }

    pub fn parameter_vector(&self) -> Vec<f64> {
        let mut out = self.parameter_values.clone();
        out.push(1.0);
        out
    }

    pub fn solver_settings(&self) -> &clarabel::solver::DefaultSettings<f64> {
        &self.solver_settings
    }

    pub fn solver_settings_mut(&mut self) -> &mut clarabel::solver::DefaultSettings<f64> {
        &mut self.solver_settings
    }

    pub fn set_solver_default_settings(&mut self) {
        self.solver_settings = clarabel::solver::DefaultSettings::<f64>::default();
        self.solver_settings.verbose = false;
    }

    pub fn set_solver_verbose(&mut self, verbose: bool) {
        self.solver_settings.verbose = verbose;
    }

    pub fn set_solver_max_iter(&mut self, max_iter: u32) {
        self.solver_settings.max_iter = max_iter;
    }

    pub fn set_solver_time_limit(&mut self, time_limit: f64) {
        self.solver_settings.time_limit = time_limit;
    }

    pub fn set_solver_tol_gap_abs(&mut self, tol_gap_abs: f64) {
        self.solver_settings.tol_gap_abs = tol_gap_abs;
    }

    pub fn set_solver_tol_gap_rel(&mut self, tol_gap_rel: f64) {
        self.solver_settings.tol_gap_rel = tol_gap_rel;
    }

    pub fn set_solver_tol_feas(&mut self, tol_feas: f64) {
        self.solver_settings.tol_feas = tol_feas;
    }

    pub fn set_parameter(&mut self, name: &str, value: &[f64]) -> Result<(), RuntimeError> {
        let parameter = PARAMETERS
            .iter()
            .find(|parameter| parameter.name == name)
            .ok_or_else(|| RuntimeError::UnknownParameter(name.to_owned()))?;

        if value.len() != parameter.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: parameter.size,
                actual: value.len(),
                name: "parameter",
            });
        }

        let start = parameter.offset;
        let end = start + parameter.size;
        self.parameter_values[start..end].copy_from_slice(value);
        Ok(())
    }

    pub fn update_parameter_entry(
        &mut self,
        name: &str,
        index: usize,
        value: f64,
    ) -> Result<(), RuntimeError> {
        let parameter = PARAMETERS
            .iter()
            .find(|parameter| parameter.name == name)
            .ok_or_else(|| RuntimeError::UnknownParameter(name.to_owned()))?;

        if index >= parameter.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: parameter.size,
                actual: index + 1,
                name: "parameter_entry",
            });
        }

        self.parameter_values[parameter.offset + index] = value;
        Ok(())
    }

__CANONICAL_METHOD__

__SOLVE_METHOD__

    pub fn extract_variable(&self, name: &str, solution: &[f64]) -> Result<Vec<f64>, RuntimeError> {
        let variable = VARIABLES
            .iter()
            .find(|variable| variable.name == name)
            .ok_or_else(|| RuntimeError::UnknownVariable(name.to_owned()))?;

        if solution.len() < variable.offset + variable.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: variable.offset + variable.size,
                actual: solution.len(),
                name: "solution",
            });
        }

        Ok(solution[variable.offset..variable.offset + variable.size].to_vec())
    }

    pub fn extract_dual_variable(
        &self,
        name: &str,
        dual_solution: &[f64],
    ) -> Result<Vec<f64>, RuntimeError> {
        let dual_variable = DUAL_VARIABLES
            .iter()
            .find(|dual_variable| dual_variable.name == name)
            .ok_or_else(|| RuntimeError::UnknownDualVariable(name.to_owned()))?;

        if dual_solution.len() < dual_variable.offset + dual_variable.size {
            return Err(RuntimeError::DimensionMismatch {
                expected: dual_variable.offset + dual_variable.size,
                actual: dual_solution.len(),
                name: "dual_solution",
            });
        }

        Ok(dual_solution[dual_variable.offset..dual_variable.offset + dual_variable.size].to_vec())
    }

