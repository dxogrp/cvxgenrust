    /// Builds the canonical quadratic cone program for the current parameters.
    ///
    /// This is useful for inspection, debugging, or calling a different solver
    /// backend. Most users should call [`CGRProblem::solve`] directly.
    pub fn canonical_cone_prob(&self) -> Result<CanonicalConeQp, RuntimeError> {
        let p_map = AffineCscMap {
            reduced: data::p_reduced(),
            pattern: data::p_pattern(),
        };

        let a_map = AffineOffsetCscMap {
            reduced: data::a_reduced(),
            pattern: data::a_pattern(),
        };

        let c_map = AffineVectorMap {
            reduced: data::c_reduced(),
            output_len: __Q_OUTPUT_LEN__usize,
        };

        let parameter_vector = self.parameter_vector();
        let p = p_map.apply(&parameter_vector)?;
        let (a, b) = a_map.apply(&parameter_vector)?;
        let (c, objective_offset) = c_map.apply(&parameter_vector)?;

        Ok(CanonicalConeQp {
            p,
            c,
            objective_offset,
            a: a.scaled(-1.0),
            b,
            cones: __CONE_DIMS__,
        })
    }
